# Local development only — never commit real secrets.
#
# Preferred: keep it out of the repo entirely with user-secrets:
#   dotnet user-secrets set "ConnectionStrings:Postgres" "<value>" --project src/DotnetApiSample.Api
#
# Alternatively, copy this file to .env and export it (see .gitignore) or set the
# environment variable directly. Environment variables override appsettings.
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=dotnet_api_sample;Username=postgres;Password=CHANGE_ME
